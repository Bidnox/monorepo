{
  "name": "bidnox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "dev:app": "bun run --cwd apps/app dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.10"
}
