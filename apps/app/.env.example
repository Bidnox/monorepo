NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Server-only Cleanverse sandbox configuration. Never prefix these with NEXT_PUBLIC_.
CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=your_sandbox_api_id

# EIP-712 signer for short-lived compliance permits. It must match the
# complianceSigner recorded in the deployment manifest and stays server-only.
COMPLIANCE_SIGNER_PRIVATE_KEY=0x...

# The faucet is available only through the local admin CLI and targets a fixed
# buyer/seller/financier allowlist. Keep disabled in hosted environments.
CLEANVERSE_FAUCET_ENABLED=false
